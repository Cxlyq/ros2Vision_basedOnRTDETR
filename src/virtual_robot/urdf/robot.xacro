<?xml version="1.0"?>
<robot name="my_stereo_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- 1. 定义一个简单的方形底盘 -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <!-- 2. 虚拟左右眼相机连杆 (这里只定义位置，真正的传感器在下面插件里) -->
  <!-- 左眼：在车头，向左偏移 0.05m -->
  <link name="camera_left_link" />
  <joint name="camera_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_left_link"/>
    <origin xyz="0.2 0.05 0.1" rpy="0 0 0"/> 
  </joint>

  <!-- 右眼：在车头，向右偏移 0.05m (基线距离=0.1m) -->
  <link name="camera_right_link" />
  <joint name="camera_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_right_link"/>
    <origin xyz="0.2 -0.05 0.1" rpy="0 0 0"/>
  </joint>

  <!-- ============================================== -->
  <!-- 3. Gazebo Ignition 插件配置区 -->
  <!-- ============================================== -->
  <gazebo reference="base_link">
    <!-- 加入差速驱动插件，监听 /cmd_vel 话题 -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <!-- 为了代码极度精简，这里省略了具体的轮子建模，使用插件内部虚拟差速 -->
      <left_joint>dummy_left</left_joint>
      <right_joint>dummy_right</right_joint>
      <wheel_separation>0.3</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
  </gazebo>

  <!-- 配置左相机传感器 -->
  <gazebo reference="camera_left_link">
    <sensor name="left_camera" type="camera">
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip><near>0.1</near><far>100</far></clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/left/image_raw</topic>
    </sensor>
  </gazebo>

  <!-- 配置右相机传感器 -->
  <gazebo reference="camera_right_link">
    <sensor name="right_camera" type="camera">
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip><near>0.1</near><far>100</far></clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/right/image_raw</topic>
    </sensor>
  </gazebo>

</robot>
